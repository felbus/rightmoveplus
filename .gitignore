# Claude (keep rules/, skills/, agents/, hooks/ and the shared settings.json committed for
# team-shared standards, workflows and editor hooks; settings.local.json stays personal)
.claude/*
!.claude/rules/
!.claude/skills/
!.claude/agents/
!.claude/hooks/
!.claude/settings.json
# .claude/plans/ holds personal working notes per .claude/plans/README.md.
# Re-include the directory so its contents can be selectively un-ignored, then
# re-ignore all files inside it (gitignore can't un-ignore a file under an
# excluded parent dir), then force-add README.md (local-only policy) and
# _template.md (starter template).
!.claude/plans/
.claude/plans/*
!.claude/plans/README.md
!.claude/plans/_template.md

# GSD / superpowers planning artifacts - phase plans, specs, briefs, and
# codebase notes go stale as features evolve. Local-only by design; the source
# of truth is the code.
.planning/
docs/superpowers/plans/
docs/superpowers/specs/

# Node.js / Next.js
node_modules/
.next/
frontend/certs/
frontend/.env.local

# App API (contains Vault-sourced secrets at runtime).
# The glob also covers local backups (.env.app-api.bak-*), which hold the same secrets
# and would otherwise be untracked files carrying credentials at repo root.
.env.app-api
.env.app-api.*
!.env.app-api.example

# Database (contain AWS credentials for S3 backup download)
.env.lucydb
.env.jerrydb

# Production Lucy creds for the scripts/pull_*.py backfill scripts (read-only prod backfill).
.env.prod-lucy

# Resolved ephemeral host ports (auto-generated by `make dc-db-up` via
# scripts/write-env-local.sh). Host-specific; never commit.
.env.local
.tdd-baseline-output.txt

# Ephemeral working docs (audits, analysis, etc.)
docs/
smoke-report.html
# Browser-snapshot / page-state dumps saved by debugging agents
stg-list-state.yml
*-state-dump.yml
.env.smoke
.tdd-context.json
.tdd-baseline-output.txt
.tdd-final-output.txt

# Agent worktree mirror (Claude Code internal)
.clone/

# Session logs - commit summaries, ignore raw transcripts and archives
session-logs/*.jsonl
session-logs/*.transcript.*
session-logs/archive/

# Generated dashboard PDF export assets (build outputs of `make build-export-bundle`)
api/features/dashboards/export_assets/

# transient handoff files between the test-env-db snapshot/terraform stages and the host stages
release_scripts/test-env-db/post-restore-targets
release_scripts/test-env-db/snapshot-label
# Flag-migration run artifacts (timestamped JSON reports, per-run)
api/scripts/flag_migration/reports/

# Local demo-environment reset utility. TRUNCATEs the AdBridge tables so the
# connect wizard can be re-run from scratch on demo; its own docstring says it
# is not checked in, and nothing was enforcing that.
scripts/demo_adbridge_clean_up.py
