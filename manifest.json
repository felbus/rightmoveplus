{
  "manifest_version": 3,
  "name": "Rightmove Plus",
  "version": "1.0.0",
  "description": "Grid view for Rightmove search results, quick-look modals for details, gallery and map on search and property pages, and no adverts.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["declarativeNetRequest"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "ads", "enabled": true, "path": "rules/ads.json" }]
  },
  "content_scripts": [
    {
      "matches": ["https://www.rightmove.co.uk/*"],
      "css": ["src/site.css"],
      "js": ["src/frame.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://www.rightmove.co.uk/*"],
      "css": ["src/ui.css", "src/search.css", "src/property.css"],
      "js": ["src/model.js", "src/acres.js", "src/ui.js", "src/search.js", "src/property.js"],
      "run_at": "document_idle"
    }
  ]
}
